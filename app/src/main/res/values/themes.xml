<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme styled with D:\UI dark design system. -->
    <style name="Theme.GeoRescuX" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/violet_accent</item>
        <item name="colorPrimaryVariant">@color/bg_app</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/violet_light</item>
        <item name="colorSecondaryVariant">@color/violet_dim</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Backgrounds and Surfaces -->
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Status bar and navigation bar. -->
        <item name="android:statusBarColor">@color/bg_app</item>
        <item name="android:navigationBarColor">@color/bg_app</item>
        <!-- Material Card Styling Defaults -->
        <item name="materialCardViewStyle">@style/Widget.GeoRescuX.Card</item>
    </style>

    <style name="Widget.GeoRescuX.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>