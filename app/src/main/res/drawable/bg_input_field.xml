<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_input" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/violet_accent" />
            <padding
                android:bottom="14dp"
                android:left="16dp"
                android:right="16dp"
                android:top="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_input" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/border_light" />
            <padding
                android:bottom="14dp"
                android:left="16dp"
                android:right="16dp"
                android:top="14dp" />
        </shape>
    </item>
</selector>
