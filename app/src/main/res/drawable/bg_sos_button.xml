<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow / border ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/sos_glow" />
        </shape>
    </item>
    <!-- Inner solid red SOS core -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/sos_red" />
            <stroke
                android:width="3dp"
                android:color="#4DFF8A80" />
        </shape>
    </item>
</layer-list>
